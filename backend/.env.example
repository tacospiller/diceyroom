NODE_ENV=development
PORT=3000

# Persistence backend:
#   file = local JSON files under DATA_DIR (no DynamoDB/Redis needed; dev only)
#   aws  = DynamoDB (users) + Redis (sessions)
PERSISTENCE=file
# Directory for the "file" backend (relative to where you run the server)
DATA_DIR=./.data

# Frontend origin — used for CORS and post-login/registration redirect
CLIENT_URL=http://localhost:5173
# This server's own public base URL (used to build uploaded-image URLs)
PUBLIC_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Only the Google account id (sub) is used — no email/name/photo is requested.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT access token (stateless). Generate a strong random value.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m

# Refresh token / persistent session (stored in Redis)
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token

# AWS / DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE=Users
# For DynamoDB Local only, e.g. http://localhost:8000 (leave blank for real AWS)
DYNAMODB_ENDPOINT=

# Redis (persistent session store)
REDIS_URL=redis://localhost:6379

# Profile-image uploads
MAX_UPLOAD_MB=5
# Local storage (PERSISTENCE=file): dir served at /uploads
UPLOAD_DIR=./.data/uploads
# S3 storage (PERSISTENCE=aws): bucket is required; S3_PUBLIC_URL optional (CDN)
S3_BUCKET=
S3_PUBLIC_URL=
